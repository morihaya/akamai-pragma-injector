{
  "name": "akamai-pragma-injector",
  "version": "1.0.1",
  "description": "Easily inject Akamai Pragma debug headers into your requests",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint .",
    "zip": "zip -r akamai-pragma-injector.zip manifest.json background.js popup.html popup.js shared/ icons/ -x '*.DS_Store'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "./tests/setup.js"
    ],
    "collectCoverageFrom": [
      "background.js",
      "popup.js",
      "shared/**/*.js"
    ]
  },
  "keywords": [
    "akamai",
    "cdn",
    "debug",
    "pragma",
    "chrome-extension",
    "edge-extension"
  ],
  "author": "",
  "license": "MIT"
}
